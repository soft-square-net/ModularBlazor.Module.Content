<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Contents Management: the Blazor client module of the Content module, loaded by ModularBlazor.BlzWebClient. Posts
    (list, create, edit, the review and publishing workflow) and the taxonomy (presses, categories), over the Content
    API.

    Shipped as soft.square.net.Module.Content.dll alone (the client part of this repo's bundle). The API client is its
    own hidden client module (WebApi.Modules.Content.Client, listed in Dependencies): referenced here to compile, never
    copied (Private=false). The host provides ModularBlazor.Abstractions (the Module SDK), Microsoft.Extensions.Http
    and the WebAssembly authentication package.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" PrivateAssets="all" />
    <!-- IStringLocalizer<T>: the host provides it (and reads this module's i18n/{culture}.json). -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.*" PrivateAssets="all" />
    <ProjectReference Include="..\WebApi.Modules.Content.Client\WebApi.Modules.Content.Client.csproj" Private="false" />
  </ItemGroup>

  <!-- Translations: i18n/{culture}.json as the resources "i18n/{culture}.json" (Module SDK 1.0.0-preview.4 and later
       embed them by itself; the same item there replaces this one). Keys are the English texts. -->
  <ItemGroup>
    <Content Remove="i18n/**" />
    <None Remove="i18n/**" />
    <EmbeddedResource Include="i18n/*.json" LogicalName="i18n/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
