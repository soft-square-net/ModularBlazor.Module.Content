@page "/contents"
@inherits ContentPageBase

@*
  Contents Management: the tenant's posts in one of the workflow views (GET /api/content/posts?view=...), and a new post
  form (POST /api/content/posts). A row opens the post. Presses and categories are on the Taxonomy page.
*@

<PageHeader Title="@L["Contents Management"]" />

<div class="mud-container ct-page">
  <header class="ct-header">
    <div>
      <p class="mud-typography mud-typography-body1 ct-muted">
        @L["Posts of your organisation and their way through review to publication. What you may do depends on your content permissions and, for the review steps, on your shift."]
      </p>
    </div>
    <div class="ct-actions">
      <div class="mud-input-control ct-inline">
        <label class="mud-input-label" for="ct-view">@L["View"]</label>
        <div class="mud-input-wrapper mud-input-wrapper--select mud-input-wrapper--dense">
          <select id="ct-view" class="mud-input-slot" value="@_view" @onchange="ViewChangedAsync">
            <option value="@PostView.Mine">@L["My posts"]</option>
            <option value="@PostView.Queue">@L["Shift queue"]</option>
            <option value="@PostView.Review">@L["My reviews"]</option>
            <option value="@PostView.Desk">@L["Desk"]</option>
          </select>
        </div>
      </div>
      <a href="contents/taxonomy" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium">@L["Presses & categories"]</a>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="LoadAsync" disabled="@Busy">@L["Refresh"]</button>
      <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="OpenCreate" disabled="@Busy">@L["New post"]</button>
    </div>
  </header>

  <div class="ct-facts">
    <span class="ct-chip">@L["Posts"] <strong>@_posts.Count</strong></span>
    @foreach (var group in _posts.GroupBy(p => p.State).OrderBy(g => g.Key))
    {
      <span class="ct-chip">@Words(group.Key) <strong>@group.Count()</strong></span>
    }
  </div>

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 ct-error" role="alert">@Error</p>
  }

  @if (_form is not null)
  {
    <section class="mud-paper mud-elevation-2 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["New post"]</h2>
      @if (_categories.Count == 0)
      {
        <p class="mud-typography mud-typography-body2 ct-muted">
          @((MarkupString)L["There are no categories yet. Add a press and a category on <a href=\"contents/taxonomy\">Presses &amp; categories</a> first."].Value)
        </p>
      }
      <form class="ct-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <div class="ct-grid">
          <div class="mud-input-control">
            <label class="mud-input-label" for="ct-category">@L["Category"]</label>
            <div class="mud-input-wrapper mud-input-wrapper--select">
              <select id="ct-category" class="mud-input-slot" @bind="_form.CategoryId" required>
                <option value="">@L["Choose…"]</option>
                @foreach (var category in _categories.OrderBy(c => c.PressId).ThenBy(c => c.NameEn))
                {
                  <option value="@category.Id">@PressName(category.PressId) / @CategoryName(category)</option>
                }
              </select>
            </div>
            <div class="mud-input-helper-text">@L["The primary category. A post may be in more categories of the same press."]</div>
          </div>
          @if (SamePress(_form.CategoryId) is { Count: > 0 } others)
          {
            <fieldset class="mud-input-control ct-wide">
              <legend class="mud-input-label">@L["More categories"]</legend>
              @foreach (var category in others)
              {
                <label class="ct-check">
                  <input type="checkbox" checked="@_form.Others.Contains(category.Id)" @onchange="e => Toggle(_form.Others, category.Id, e)" />
                  @CategoryName(category)
                </label>
              }
            </fieldset>
          }
          <div class="mud-input-control">
            <label class="mud-input-label" for="ct-kind">@L["Kind"]</label>
            <div class="mud-input-wrapper mud-input-wrapper--select">
              <select id="ct-kind" class="mud-input-slot" @bind="_form.Kind" required>
                @foreach (var kind in PickerKinds)
                {
                  <option value="@kind">@KindName(kind)</option>
                }
              </select>
            </div>
            @if (KindsError is not null)
            {
              <div class="mud-input-helper-text ct-error" role="status">@L["The tenant's post kinds could not be read, so the standard ones are listed. Creating the post may fail until Dynamic Fields answers. ({0})", KindsError]</div>
            }
            else if (Kinds is { Count: 0 })
            {
              <div class="mud-input-helper-text" role="status">@L["No post kind is published yet: publish a root post field in Dynamic Fields first."]</div>
            }
          </div>
          <div class="mud-input-control ct-wide">
            <label class="mud-input-label" for="ct-title">@L["Title"]</label>
            <div class="mud-input-wrapper">
              <input id="ct-title" class="mud-input-slot" @bind="_form.Title" required maxlength="300" />
            </div>
          </div>
          <div class="mud-input-control ct-wide">
            <label class="mud-input-label" for="ct-body">@L["Body"]</label>
            <div class="mud-input-wrapper">
              <textarea id="ct-body" class="mud-input-slot ct-body" rows="8" @bind="_form.Body"></textarea>
            </div>
            <div class="mud-input-helper-text">@L["Saved as a draft. Submit it for review from the post's page."]</div>
          </div>
        </div>
        <div class="ct-row-actions">
          <button type="submit" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" disabled="@(Busy || _categories.Count == 0 || PickerKinds.Count == 0)">@L["Create draft"]</button>
          <button type="button" class="mud-button-root mud-button-text mud-button-surface mud-button-medium" @onclick="() => _form = null">@L["Cancel"]</button>
        </div>
      </form>
    </section>
  }

  <section class="mud-paper mud-elevation-1 ct-card">
    <MudTailDataTable @ref="_table" Columns="Columns" OnRowClick="OpenPost" EmptyText="@L["No posts in this view."]" />
  </section>
</div>

@code {
  private sealed class PostForm
  {
    public string CategoryId { get; set; } = "";
    public HashSet<string> Others { get; } = [];
    public string Kind { get; set; } = "post.article";
    public string Title { get; set; } = "";
    public string? Body { get; set; }
  }

  private IReadOnlyList<object> Columns =>
  [
    new { key = "id", title = L["#"].Value, type = "number", width = "80px" },
    new { key = "title", title = L["Title"].Value },
    new { key = "kind", title = L["Kind"].Value, type = "enum", options = PickerKinds.Concat(_posts.Select(p => p.PostKind)).Distinct().Select(KindName).ToArray(), width = "130px" },
    new { key = "category", title = L["Category"].Value },
    new { key = "state", title = L["State"].Value, type = "enum", options = Enum.GetValues<PostState>().Select(s => Words(s)).ToArray(), width = "170px" },
    new { key = "scheduled", title = L["Scheduled for"].Value },
    new { key = "updated", title = L["Updated"].Value },
  ];

  /// <summary>The kinds the form offers: the tenant's published ones; the starter library's while they cannot be read.</summary>
  private List<string> PickerKinds => Kinds?.Select(k => k.Key).ToList() ?? ContentNames.StarterKinds.Select(k => k.Key).ToList();

  private MudTailDataTable? _table;
  private PostView _view = PostView.Mine;
  private List<PostSummary> _posts = [];
  private List<PressDto> _presses = [];
  private List<CategoryDto> _categories = [];
  private PostForm? _form;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender) await LoadAsync();
  }

  private async Task LoadAsync()
  {
    await RunAsync(async () =>
    {
      await LoadKindsAsync();
      var client = Content;
      _presses = (await client.ListPressesAsync()).ToList();
      _categories = (await client.ListCategoriesAsync()).ToList();
      _posts = (await client.ListPostsAsync(_view)).OrderByDescending(p => p.UpdatedAt).ToList();
      if (_table is not null) await _table.SetDataAsync(_posts.Select(ToRow).ToList());
    });
  }

  private object ToRow(PostSummary p) => new
  {
    id = p.Id.ToString(),
    title = p.Title,
    kind = KindName(p.PostKind),
    category = $"{PressName(p.PressId)} / {CategoryLabel(p.CategoryId)}",
    state = Words(p.State),
    scheduled = When(p.ScheduledFor),
    updated = When(p.UpdatedAt),
  };

  private string PressName(string id) => _presses.FirstOrDefault(p => p.Id == id)?.Name ?? id;

  private string CategoryLabel(string id) => _categories.FirstOrDefault(c => c.Id == id) is { } category ? CategoryName(category) : id;

  /// <summary>The other categories of the press of <paramref name="primary"/> (a post's categories are all of its press).</summary>
  private List<CategoryDto> SamePress(string? primary) =>
    _categories.FirstOrDefault(c => c.Id == primary) is { } chosen
      ? _categories.Where(c => c.PressId == chosen.PressId && c.Id != chosen.Id).OrderBy(c => c.NameEn).ToList()
      : [];

  private static void Toggle(HashSet<string> set, string id, ChangeEventArgs e)
  {
    if (e.Value is true) set.Add(id); else set.Remove(id);
  }

  private async Task ViewChangedAsync(ChangeEventArgs e)
  {
    if (Enum.TryParse<PostView>(e.Value?.ToString(), out var view)) _view = view;
    await LoadAsync();
  }

  private async Task OpenCreate()
  {
    await LoadKindsAsync(); // a kind published since the page opened is offered too
    var kinds = PickerKinds;
    _form = new PostForm
    {
      CategoryId = _categories.Count == 1 ? _categories[0].Id : "",
      Kind = kinds.Contains("post.article") ? "post.article" : kinds.FirstOrDefault() ?? "",
    };
  }

  private void OpenPost(string id) => Nav.NavigateTo($"contents/posts/{Uri.EscapeDataString(id)}");

  private async Task CreateAsync()
  {
    if (_form is null) return;
    var form = _form;
    PostDetail? created = null;
    var ok = await RunAsync(async () =>
    {
      created = await Content.CreatePostAsync(new NewPost
      {
        CategoryId = form.CategoryId,
        CategoryIds = SamePress(form.CategoryId).Select(c => c.Id).Where(form.Others.Contains).ToList(),
        Title = form.Title.Trim(),
        Body = string.IsNullOrWhiteSpace(form.Body) ? null : form.Body,
        PostKind = form.Kind,
      });
      await MudTail.ToastAsync(L["Draft #{0} created.", created.Id], "success");
      _form = null;
    });
    if (ok && created is not null) OpenPost(created.Id.ToString());
  }
}
