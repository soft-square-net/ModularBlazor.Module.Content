@page "/contents/posts/{Id:int}"
@inherits ContentPageBase
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using soft.square.net.ModularBlazor.Abstractions
@inject IModuleDialogs ModuleDialogs

@*
  One post (GET /api/content/posts/{id}): edit it, move it through the workflow (submit, accept, assign, approve,
  return, schedule, publish) and read its history. The buttons follow the post's state; the API decides whether you
  may, from your content permissions and your shift. Every step sends the version you see (409 if it changed).
*@

<PageHeader Title="@(_post?.Title ?? L["Post {0}", Id])" />

<div class="mud-container ct-page">
  <a href="contents" class="mud-button-root mud-button-text mud-button-primary mud-button-small ct-back">@L["← Contents Management"]</a>

  <header class="ct-header">
    <div>
      @if (_post is not null)
      {
        <p class="mud-typography mud-typography-body1 ct-muted">
          #@_post.Id · @KindName(_post.PostKind) · @_post.PressId / @CategoryLabel(_post.CategoryId) · @L["version {0}", _post.Version]
        </p>
      }
    </div>
    <div class="ct-actions">
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="LoadAsync" disabled="@Busy">@L["Refresh"]</button>
    </div>
  </header>

  @if (_post is not null)
  {
    <div class="ct-facts">
      <span class="ct-chip ct-state">@L["State"] <strong>@Words(_post.State)</strong></span>
      <span class="ct-chip">@L["Owner"] <strong>@_post.OwnerId</strong></span>
      <span class="ct-chip" title="@L["Set by the workflow from the moderator's choice; it cannot be changed here."] @_post.UnitId">
        @L["Unit"] <strong>@(_post.UnitId is { } unit ? UnitName(unit) : L["none"].Value)</strong>
      </span>
      @if (_post.AssigneeId is not null) { <span class="ct-chip">@L["Assignee"] <strong>@_post.AssigneeId</strong></span> }
      @if (_post.AcceptedShiftId is not null) { <span class="ct-chip">@L["Shift"] <strong>@_post.AcceptedShiftId</strong></span> }
      @if (_post.ScheduledFor is not null) { <span class="ct-chip">@L["Scheduled for"] <strong>@When(_post.ScheduledFor)</strong></span> }
      @if (_post.PublishedAt is not null) { <span class="ct-chip">@L["Published"] <strong>@When(_post.PublishedAt)</strong></span> }
      @if (!string.IsNullOrEmpty(_post.Permalink)) { <span class="ct-chip">@L["Permalink"] <strong>@_post.Permalink</strong></span> }
      @if (!string.IsNullOrEmpty(_post.CanonicalPath)) { <span class="ct-chip">@L["Public path"] <strong>@_post.CanonicalPath</strong></span> }
      else if (string.IsNullOrEmpty(_post.UrlPrefix)) { <span class="ct-chip">@L["No URL prefix: this kind has no published DynamicFields root field, so the post cannot be published yet."]</span> }
    </div>
  }

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 ct-error" role="alert">@Error</p>
  }

  @if (_post is not null)
  {
    <section class="mud-paper mud-elevation-1 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["Workflow"]</h2>
      <div class="ct-row-actions">
        @if (_post.State is PostState.Draft or PostState.Returned)
        {
          <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="SubmitAsync" disabled="@Busy">@L["Submit for review"]</button>
        }
        @if (_post.State is PostState.Submitted)
        {
          <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="AcceptAsync" disabled="@Busy">@L["Accept"]</button>
        }
        @if (_post.State is PostState.InReview)
        {
          <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="ApproveAsync" disabled="@Busy">@L["Approve"]</button>
        }
        @if (_post.State is PostState.Approved or PostState.Scheduled or PostState.AwaitingDeskReapproval)
        {
          <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="PublishAsync" disabled="@Busy">@L["Publish now"]</button>
        }
      </div>

      @if (_post.State is PostState.Accepted or PostState.InReview)
      {
        <form class="ct-inline-form" @onsubmit="AssignAsync" @onsubmit:preventDefault>
          <div class="mud-input-control ct-inline">
            <label class="mud-input-label" for="ct-assignee">@L["Editor"]</label>
            <div class="mud-input-wrapper"><input id="ct-assignee" class="mud-input-slot" @bind="_assigneeId" required placeholder="@L["user id"]" /></div>
          </div>
          <button type="submit" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" disabled="@Busy">@L["Assign"]</button>
        </form>
      }
      @if (_post.State is PostState.Approved or PostState.Scheduled)
      {
        <form class="ct-inline-form" @onsubmit="ScheduleAsync" @onsubmit:preventDefault>
          <div class="mud-input-control ct-inline">
            <label class="mud-input-label" for="ct-at">@L["Publish at (local time)"]</label>
            <div class="mud-input-wrapper"><input id="ct-at" type="datetime-local" class="mud-input-slot" @bind="_publishAt" required /></div>
          </div>
          <button type="submit" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" disabled="@Busy">@L["Schedule"]</button>
        </form>
      }
      @if (_post.State is PostState.Submitted or PostState.Accepted or PostState.InReview or PostState.Approved
             or PostState.Scheduled or PostState.AwaitingDeskReapproval)
      {
        <form class="ct-inline-form" @onsubmit="ReturnAsync" @onsubmit:preventDefault>
          <div class="mud-input-control ct-inline ct-grow">
            <label class="mud-input-label" for="ct-reason">@L["Reason"]</label>
            <div class="mud-input-wrapper"><input id="ct-reason" class="mud-input-slot" @bind="_returnReason" placeholder="@L["what the author should change"]" /></div>
          </div>
          <button type="submit" class="mud-button-root mud-button-outlined mud-button-error mud-button-medium" disabled="@Busy">@L["Return to author"]</button>
        </form>
      }
    </section>

    <section class="mud-paper mud-elevation-1 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["Categories"]</h2>
      <p class="mud-typography mud-typography-body2 ct-muted">
        @L["A post is in one primary category and any others of its press. Its unit is set by the workflow and is shown read-only."]
      </p>
      <form class="ct-form" @onsubmit="SaveCategoriesAsync" @onsubmit:preventDefault>
        <div class="ct-grid">
          <div class="mud-input-control">
            <label class="mud-input-label" for="ct-primary">@L["Primary category"]</label>
            <div class="mud-input-wrapper mud-input-wrapper--select">
              <select id="ct-primary" class="mud-input-slot" @bind="_primary" required>
                @foreach (var category in PressCategories)
                {
                  <option value="@category.Id">@CategoryName(category)</option>
                }
              </select>
            </div>
          </div>
          <fieldset class="mud-input-control ct-wide">
            <legend class="mud-input-label">@L["More categories"]</legend>
            @foreach (var category in PressCategories.Where(c => c.Id != _primary))
            {
              <label class="ct-check">
                <input type="checkbox" checked="@_others.Contains(category.Id)" @onchange="e => ToggleOther(category.Id, e)" />
                @CategoryName(category)
              </label>
            }
          </fieldset>
        </div>
        <div class="ct-row-actions">
          <button type="submit" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" disabled="@Busy">@L["Save categories"]</button>
        </div>
      </form>
    </section>

    <section class="mud-paper mud-elevation-1 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["{0} values", KindName(_post.PostKind)]</h2>
      @if (IsLegacy)
      {
        <p class="mud-typography mud-typography-body2 ct-error" role="status">
          @L["This post was made from a title and a body only: it has none of its kind's values, so the designer's check fails on it. Fill them in to give it them; the title, the body and the contents stay as they are."]
        </p>
      }
      else
      {
        <p class="mud-typography mud-typography-body2 ct-muted">
          @L["The headline, summary, image and the other values of the post's kind. The post is checked against them when it is approved, scheduled or published."]
        </p>
      }
      @if (CanEditValues)
      {
        <div class="ct-row-actions">
          <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="EditValuesAsync" disabled="@Busy">@(IsLegacy ? L["Fill in the values"] : L["Edit values"])</button>
        </div>
      }
      else
      {
        <p class="mud-typography mud-typography-body2 ct-muted">@L["Editing the values needs the Dynamic Fields module (its edit-content dialog)."]</p>
      }
    </section>

    <section class="mud-paper mud-elevation-1 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["Content"]</h2>
      <form class="ct-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="ct-grid">
          <div class="mud-input-control ct-wide">
            <label class="mud-input-label" for="ct-edit-title">@L["Title"]</label>
            <div class="mud-input-wrapper"><input id="ct-edit-title" class="mud-input-slot" @bind="_title" required maxlength="300" /></div>
          </div>
          <div class="mud-input-control ct-wide">
            <label class="mud-input-label" for="ct-edit-body">@L["Body"]</label>
            <div class="mud-input-wrapper"><textarea id="ct-edit-body" class="mud-input-slot ct-body" rows="12" @bind="_body"></textarea></div>
            @if (!_post.OwnerMayEdit && _post.State is not (PostState.Draft or PostState.Returned))
            {
              <div class="mud-input-helper-text">@L["The owner's edit window has closed; reviewers on shift may still edit."]</div>
            }
          </div>
        </div>
        <div class="ct-row-actions">
          <button type="submit" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" disabled="@Busy">@L["Save"]</button>
        </div>
      </form>
    </section>

    <section class="mud-paper mud-elevation-1 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["Translations"]</h2>
      <p class="mud-typography mud-typography-body2 ct-muted">
        @L["The content's text in other languages. Readers get the translation of their language, else the content as written. A published post shows a new translation at once."]
      </p>
      @if (_post.Translations.Count == 0)
      {
        <p class="mud-typography mud-typography-body2 ct-muted">@L["No translations yet."]</p>
      }
      else
      {
        <ul class="ct-translations">
          @foreach (var t in _post.Translations.OrderBy(t => t.Language))
          {
            var language = t.Language;
            <li>
              <strong>@LanguageName(language)</strong>
              <span class="ct-muted">@L["{0} values · {1} by {2}", t.Nodes.Sum(n => n.Value.Count), When(t.UpdatedAt), t.UpdatedBy]</span>
              @if (CanTranslate)
              {
                <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" disabled="@Busy" @onclick="() => TranslateAsync(language)">@L["Edit"]</button>
              }
              <button type="button" class="mud-button-root mud-button-text mud-button-small" disabled="@Busy" @onclick="() => RemoveTranslationAsync(language)">@L["Remove"]</button>
            </li>
          }
        </ul>
      }
      @if (CanTranslate)
      {
        <div class="ct-row-actions">
          <div class="mud-input-control ct-inline">
            <label class="mud-input-label" for="ct-translate-language">@L["Language"]</label>
            <div class="mud-input-wrapper">
              <input id="ct-translate-language" class="mud-input-slot" list="ct-languages" maxlength="35" @bind="_language" />
              <datalist id="ct-languages"><option value="ar">العربية</option><option value="en">English</option></datalist>
            </div>
          </div>
          <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" disabled="@(Busy || string.IsNullOrWhiteSpace(_language))"
                  @onclick="() => TranslateAsync(_language!.Trim())">@L["Translate"]</button>
        </div>
      }
      else
      {
        <p class="mud-typography mud-typography-body2 ct-muted">@L["Translating needs the Dynamic Fields module (its translate-content dialog)."]</p>
      }
    </section>

    <section class="mud-paper mud-elevation-1 ct-card">
      <h2 class="mud-typography mud-typography-h6">@L["History"]</h2>
      @if (_post.History.Count == 0)
      {
        <p class="mud-typography mud-typography-body2 ct-muted">@L["No events yet."]</p>
      }
      else
      {
        <ol class="ct-history">
          @foreach (var e in _post.History.OrderByDescending(e => e.At))
          {
            <li>
              <span class="ct-muted">@When(e.At)</span>
              <strong>@e.Action</strong> by @e.Actor → @Words(e.State)
              @if (!string.IsNullOrWhiteSpace(e.Detail)) { <span class="ct-muted">(@e.Detail)</span> }
            </li>
          }
        </ol>
      }
    </section>
  }
</div>

@code {
  [Parameter] public int Id { get; set; }

  private PostDetail? _post;
  private string _title = "";
  private string? _body;
  private string? _assigneeId;
  private string? _returnReason;
  private DateTime? _publishAt;
  private List<CategoryDto> _categories = [];
  private string? _primary;
  private HashSet<string> _others = [];

  protected override async Task OnParametersSetAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    await RunAsync(async () =>
    {
      await LoadKindsAsync();
      var client = Content;
      _categories = (await client.ListCategoriesAsync()).ToList();
      Show(await client.GetPostAsync(Id));
    });
    await LoadUnitNameAsync();
  }

  /// <summary>Organization's names of a unit (its local directory).</summary>
  private sealed record UnitNames(string? NameEn, string? NameAr);

  private (Guid Id, UnitNames Names)? _unit;

  private string UnitName(Guid id)
  {
    var names = _unit is { } known && known.Id == id ? known.Names : null;
    return ContentNames.Unit(id, names?.NameEn, names?.NameAr, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
  }

  /// <summary>
  /// Names the post's unit. Organization is optional: when it is not installed, cannot be reached or refuses the caller,
  /// the chip shows the start of the unit's id.
  /// </summary>
  private async Task LoadUnitNameAsync()
  {
    if (_post?.UnitId is not { } id || _unit?.Id == id) return;
    try
    {
      var http = HttpClients.CreateClient(HttpClientNames.WebApi);
      if (await http.GetFromJsonAsync<UnitNames>($"api/organization/local/units/{id:D}") is { } names) _unit = (id, names);
    }
    catch (AccessTokenNotAvailableException ex) { ex.Redirect(); }
    catch (Exception ex) when (ex is HttpRequestException or JsonException or NotSupportedException or TaskCanceledException) { }
    StateHasChanged();
  }

  private const string ValuesDialog = "Module.DynamicFields/edit-content";

  private bool CanEditValues => ModuleDialogs.IsAvailable(ValuesDialog);

  private bool IsLegacy => _post?.Document.SchemaId == "legacy.basic";

  /// <summary>
  /// Opens DynamicFields' edit-content dialog on the document's root (the values of the post's kind) and keeps what it
  /// returns. A legacy post starts from its title as the headline, at the kind's newest version.
  /// </summary>
  private async Task EditValuesAsync()
  {
    if (_post is null) return;
    var legacy = IsLegacy;
    var result = await ModuleDialogs.ShowAsync(ValuesDialog, new
    {
      field = legacy ? _post.PostKind : _post.Document.SchemaId,
      version = legacy ? 0 : _post.Document.SchemaVersion,
      content = legacy ? JsonSerializer.SerializeToElement(new { headline = _post.Title }) : _post.Document.Content,
      style = legacy ? JsonSerializer.SerializeToElement(new { }) : _post.Document.Style
    });
    if (result.Canceled || result.As<RootValues>() is not { } values) return;
    await StepAsync((c, v) => c.SetPostRootAsync(Id, new PostRootEdit
    {
      Version = v,
      FieldVersion = values.Version,
      Content = values.Content,
      Style = values.Style,
    }), "Saved.");
  }

  /// <summary>What the edit-content dialog returns (the parts Content keeps).</summary>
  private sealed record RootValues(int Version, JsonElement Content, JsonElement Style);

  /// <summary>The categories of the post's press (a post's categories are all of its press).</summary>
  private IEnumerable<CategoryDto> PressCategories =>
    _post is null ? [] : _categories.Where(c => c.PressId == _post.PressId).OrderBy(c => c.NameEn);

  private string CategoryLabel(string id) => _categories.FirstOrDefault(c => c.Id == id) is { } category ? CategoryName(category) : id;

  private void ToggleOther(string id, ChangeEventArgs e)
  {
    if (e.Value is true) _others.Add(id); else _others.Remove(id);
  }

  private Task SaveCategoriesAsync() => StepAsync((c, v) => c.SetPostCategoriesAsync(Id, new PostCategories
  {
    Version = v,
    PrimaryCategoryId = _primary ?? _post!.CategoryId,
    CategoryIds = _others.Where(o => o != _primary).ToList(),
  }), "Categories saved.");

  private void Show(PostDetail post)
  {
    _post = post;
    _title = post.Title;
    _body = post.Body;
    _primary = post.CategoryId;
    _others = [.. post.Categories.Where(c => c != post.CategoryId)];
    _publishAt ??= post.ScheduledFor?.LocalDateTime ?? DateTime.Now.AddHours(1);
  }

  /// <summary>One workflow step on the version on screen, then the post as the API returns it.</summary>
  private async Task StepAsync(Func<ContentClient, int, Task<PostDetail>> step, string done)
  {
    if (_post is null) return;
    var version = _post.Version;
    await RunAsync(async () =>
    {
      Show(await step(Content, version));
      await MudTail.ToastAsync(L[done], "success");
    });
    await LoadUnitNameAsync();
  }

  private Task SaveAsync() => StepAsync((c, v) => c.EditPostAsync(Id, new PostEdit { Version = v, Title = _title.Trim(), Body = _body }), "Saved.");

  private Task SubmitAsync() => StepAsync((c, v) => c.SubmitPostAsync(Id, new VersionRequest { Version = v }), "Submitted for review.");

  private Task AcceptAsync() => StepAsync((c, v) => c.AcceptPostAsync(Id, new AcceptRequest { Version = v }), "Accepted into the review queue.");

  private Task AssignAsync() => StepAsync((c, v) => c.AssignPostAsync(Id, new Assignment { Version = v, AssigneeId = (_assigneeId ?? "").Trim() }), "Assigned.");

  private Task ApproveAsync() => StepAsync((c, v) => c.ApprovePostAsync(Id, new VersionRequest { Version = v }), "Approved.");

  private Task ReturnAsync() => StepAsync((c, v) => c.ReturnPostAsync(Id, new ReturnRequest
  {
    Version = v,
    Reason = string.IsNullOrWhiteSpace(_returnReason) ? null : _returnReason.Trim(),
  }), "Returned to the author.");

  private Task ScheduleAsync() => StepAsync((c, v) => c.SchedulePostAsync(Id, new ScheduleRequest
  {
    Version = v,
    PublishAt = new DateTimeOffset(_publishAt ?? DateTime.Now.AddHours(1)),
  }), "Scheduled.");

  private Task PublishAsync() => StepAsync((c, v) => c.PublishPostAsync(Id, new VersionRequest { Version = v }), "Published.");

  private const string TranslateDialog = "Module.DynamicFields/translate-content";
  private string? _language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en" : "ar";

  private bool CanTranslate => ModuleDialogs.IsAvailable(TranslateDialog);

  /// <summary>
  /// Opens DynamicFields' translate dialog on the post's document (its root and nodes, as content nodes) with the
  /// existing translation, and keeps what it returns (already checked against the fields).
  /// </summary>
  private async Task TranslateAsync(string language)
  {
    if (_post is null || !IsLanguage(language)) return;
    var existing = _post.Translations.FirstOrDefault(t => string.Equals(t.Language, language, StringComparison.OrdinalIgnoreCase));
    var root = new
    {
      field = _post.Document.SchemaId,
      fieldVersion = _post.Document.SchemaVersion,
      content = _post.Document.Content,
      style = _post.Document.Style,
      children = _post.Document.Children.Select(ToNode).ToList()
    };
    var result = await ModuleDialogs.ShowAsync(TranslateDialog, new
    {
      root,
      language = existing?.Language ?? language,
      translation = existing is null ? null : new { language = existing.Language, nodes = existing.Nodes }
    });
    if (result.Canceled || result.As<Overlay>() is not { } overlay) return;
    var version = _post.Version;
    await RunAsync(async () =>
    {
      Show(await Content.TranslatePostAsync(Id, overlay.Language ?? language, new PostTranslationEdit { Version = version, Nodes = overlay.Nodes ?? new Dictionary<string, IDictionary<string, TranslatedText>>() }));
      await MudTail.ToastAsync(L["Translation into {0} saved.", LanguageName(overlay.Language ?? language)], "success");
    });
  }

  private Task RemoveTranslationAsync(string language) =>
    StepAsync((c, v) => c.RemovePostTranslationAsync(Id, language, v), "Translation removed.");

  /// <summary>What the translate dialog returns.</summary>
  private sealed record Overlay(string? Language, Dictionary<string, IDictionary<string, TranslatedText>>? Nodes);

  private static object ToNode(PostNode node) => new
  {
    nodeId = node.NodeId,
    field = node.SchemaId,
    fieldVersion = node.SchemaVersion,
    content = node.Content,
    style = node.Style,
    children = node.Children.Select(ToNode).ToList()
  };

  private static bool IsLanguage(string? tag) =>
    tag is { Length: > 0 and <= 35 } && System.Text.RegularExpressions.Regex.IsMatch(tag, "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$");

  private static string LanguageName(string language)
  {
    try { return $"{CultureInfo.GetCultureInfo(language).NativeName} ({language})"; }
    catch (CultureNotFoundException) { return language; }
  }
}
